datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id          String    @id @default(cuid())
  name        String    // e.g. "Proton", "Perodua", "ST Muar"
  code        String    @unique // e.g. "PROTON", "PERODUA", "STM"
  description String?
  sites       Site[]
  users       User[]
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Site {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String         // e.g. "Johor Plant", "Penang Plant"
  code        String         // e.g. "JOHOR", "PENANG"
  location    String?
  robots      Robot[]
  projects    Project[]
  shortStops  ShortStopLog[]
  issues      Issue[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([companyId, code])
}

model Robot {
  id           String         @id @default(cuid())
  siteId       String
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  code         String         // e.g. "AGV-01", "ARV-03"
  name         String?        // e.g. "Titan Line A Unit 1"
  model        String         @default("Titan")
  type         String         @default("AGV") // "AGV" | "AMR" | "ARV"
  status       String         @default("RUNNING") // "RUNNING" | "IDLE" | "SHORT_STOP" | "MAINTENANCE" | "OFFLINE"
  lineZone     String?        // e.g. "Zone A - Stamping"
  ipAddress    String?
  qrPayload    String?
  issues       Issue[]
  shortStops   ShortStopLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([siteId, code])
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique // e.g. "perodua", "proton", "intern", "engineer.df"
  email           String?   @unique // e.g. engineer@df.com for Google Auth
  passwordHash    String    // bcrypt hashed password
  name            String
  role            String    @default("CUSTOMER") // "ADMIN" | "ENGINEER" | "CUSTOMER" | "INTERN"
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedSiteIds String    @default("[]") // JSON string of site IDs this user is authorized to view
  googleLinked    Boolean   @default(false)
  avatarUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Project {
  id              String          @id @default(cuid())
  name            String          // e.g. "Proton Johor AGV Deployment Phase 1"
  code            String          @unique // e.g. "PRJ-PTN-JHR-01"
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteId          String
  site            Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status          String          @default("ACTIVE") // "PLANNING" | "ACTIVE" | "ON_HOLD" | "COMPLETED"
  health          String          @default("ON_TRACK") // "ON_TRACK" | "AT_RISK" | "OFF_TRACK"
  leadEngineer    String          @default("Lead Engineer")
  targetGoLive    DateTime?
  description     String?
  gdriveFolderUrl String?         // Google Drive link for synced viewing
  actionItems     ActionItem[]
  issues          Issue[]
  meetingMinutes  MeetingMinute[]
  dailyReports    DailyReport[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ActionItem {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemNo        String    // e.g. "OAL-001"
  title         String
  description   String?
  owner         String
  priority      String    @default("MEDIUM") // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW"
  category      String    @default("HARDWARE") // "HARDWARE" | "SOFTWARE" | "MECHANICAL" | "NETWORK" | "FACILITY" | "SAFETY"
  status        String    @default("OPEN") // "OPEN" | "IN_PROGRESS" | "BLOCKED" | "DONE"
  targetDate    DateTime?
  completedDate DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Issue {
  id                      String    @id @default(cuid())
  issueNo                 String    // e.g. "ISS-001"
  projectId               String?
  project                 Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  siteId                  String
  site                    Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  robotId                 String?
  robot                   Robot?    @relation(fields: [robotId], references: [id], onDelete: SetNull)
  title                   String
  description             String?
  severity                String    @default("MODERATE") // "CRITICAL" | "MAJOR" | "MODERATE" | "MINOR"
  rootCauseCategory       String    @default("OTHER") // "PANEL_TRANSFER", "WHEEL_SLIPPAGE", "CASSETTE_STUCK", "MACHINE_ISSUE", etc.
  fiveWhyAnalysis         String?   // Root-cause 5-Why analysis notes
  immediateAction         String?
  permanentCountermeasure String?
  status                  String    @default("OPEN") // "OPEN" | "INVESTIGATING" | "COUNTERMEASURE_PROPOSED" | "VALIDATING" | "CLOSED"
  loggedBy                String
  assignedTo              String?
  createdAt               DateTime  @default(now())
  closedAt                DateTime?
  updatedAt               DateTime  @updatedAt
}

model ShortStopLog {
  id              String   @id @default(cuid())
  siteId          String
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  robotId         String
  robot           Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  category        String   // "Panel Transfer Stuck", "Wheel Slippage", "Obstacle Detect", etc.
  zone            String?  // e.g. "Stamping Pit", "Dock 2"
  specificLocation String? // e.g. "PIT DOCK CONSTRUCTION BHR APG BR-02"
  startTime       DateTime
  recoveryTime    DateTime?
  durationMinutes Float    @default(1.0)
  resolvedBy      String?
  recoveryAction  String?  // "Auto Resume", "Operator Reset", "E-Stop Release", "Reboot"
  notes           String?
  createdAt       DateTime @default(now())
}

model MeetingMinute {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  meetingDate  DateTime  @default(now())
  attendees    String    // Comma-separated or JSON list
  agenda       String?
  keyDecisions String?
  driveLink    String?   // Synced Google Drive link
  htmlContent  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model DailyReport {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportDate     DateTime  @default(now())
  engineerName   String
  shift          String    @default("DAY") // "DAY" | "NIGHT" | "FULL"
  activitiesDone String
  blockers       String?
  nextPlan       String?
  driveLink      String?   // Synced Google Drive link
  htmlContent    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
